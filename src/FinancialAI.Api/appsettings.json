{
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 60
  },
  "ServiceBus": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ReportWorkflow": {
    "HumanReviewConfidenceThreshold": 0.7,
    "MaximumRevisionAttempts": 2,
    "ConservativeReturnAdjustment": 0.02,
    "ConservativeInflationAdjustment": 0.01
  },
  "Cosmos": {
    "ConnectionString": "",
    "BootstrapContainers": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}