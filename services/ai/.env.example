# stub — deterministic, used by gated suite and dev default
# real — OpenAI-compatible endpoint from vars below
LLM_PROVIDER=stub

# Provider examples:
#   OpenRouter (free DeepSeek / Qwen tiers):
#     https://openrouter.ai/api/v1  +  deepseek/deepseek-r1-0528:free
#   Groq (free tier, Qwen):
#     https://api.groq.com/openai/v1  +  qwen/qwen3.8-27b
#   HuggingFace (single token, many models):
#     https://router.huggingface.co/v1  +  deepseek-ai/DeepSeek-R1
#   DeepSeek (paid):
#     https://api.deepseek.com/v1  +  deepseek-chat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-r1-0528:free
LLM_API_KEY=

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
