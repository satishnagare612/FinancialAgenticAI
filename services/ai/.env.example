# LLM_PROVIDER: stub (deterministic, gated suite) | real (preset below)
LLM_PROVIDER=stub

# Pick one of: openrouter, groq, gemini, cerebras, mistral, github, ollama
# Setting LLM_PROVIDER=real + LLM_PRESET=<name> + LLM_API_KEY=<key> is enough.
LLM_PRESET=openrouter

# --- Preset defaults (override only if needed) ---
# openrouter : https://openrouter.ai/api/v1         deepseek/deepseek-r1-0528:free
# groq       : https://api.groq.com/openai/v1       openai/gpt-oss-120b
# gemini     : https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.8-flash
# cerebras   : https://api.cerebras.ai/v1           gpt-oss-120b
# mistral    : https://api.mistral.ai/v1            mistral-large-3
# github     : https://models.github.ai/inference   openai/gpt-4.1
# ollama     : http://localhost:11434/v1            llama3.3

# Leave these blank to use the preset's base_url and model.
LLM_BASE_URL=
LLM_MODEL=

# Required when LLM_PROVIDER=real. Obtain from the provider's console.
#   OpenRouter : https://openrouter.ai/keys
#   Groq       : https://console.groq.com/keys
#   Gemini     : https://aistudio.google.com/apikey
#   Cerebras   : https://cloud.cerebras.ai
#   Mistral    : https://console.mistral.ai/api-keys
#   GitHub     : GitHub PAT with `models:read` scope
#   Ollama     : any string (e.g. "ollama")
LLM_API_KEY=

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
