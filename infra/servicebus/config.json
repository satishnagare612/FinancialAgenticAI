{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [
          {
            "Name": "financial-ai-work",
            "Properties": {
              "DeadLetteringOnMessageExpiration": true,
              "MaxDeliveryCount": 10,
              "DefaultMessageTimeToLive": "PT1H"
            }
          }
        ],
        "Topics": [
          {
            "Name": "financial-ai-events",
            "Subscriptions": [
              {
                "Name": "report-generated",
                "Properties": {
                  "MaxDeliveryCount": 10,
                  "DefaultMessageTimeToLive": "PT1H"
                }
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  }
}